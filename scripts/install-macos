#!/bin/bash
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release

# ray/master: this build lives next to the official /Applications/Herdr.app under its own name, so both can be
# installed at once. The app and the executable must not end in "Herdr.app/Contents/MacOS/Herdr": that exact
# ending is how the app recognises an official bundle and keeps ~/.local/bin/herdr-app pointing at it, so a
# different name keeps the two from taking that link from each other.
# TEST:src/core_bin/cli_link.rs[repairs_only_our_cli_link]
app="/Applications/Herdr-ray.app"
exe="$app/Contents/MacOS/Herdr-ray"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$HOME/.local/bin"
# Replace atomically so installing does not interrupt a running Herdr.
cp target/release/herdr-app "$exe.new"
mv -f "$exe.new" "$exe"
chmod +x "$exe"
# ray/master: the icon is the stock one turned 180 degrees, so this build is easy to tell from the official app.
# The file keeps the name Herdr.icns inside the bundle because CFBundleIconFile below says "Herdr".
cp assets/icons/Herdr-rotated.icns "$app/Contents/Resources/Herdr.icns"

cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Herdr-ray</string>
    <key>CFBundleIdentifier</key><string>dev.herdr.app.ray</string>
    <key>CFBundleName</key><string>Herdr-ray</string>
    <key>CFBundleDisplayName</key><string>Herdr-ray</string>
    <key>CFBundleIconFile</key><string>Herdr</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.0.1</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Herdr can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Herdr can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Herdr can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
# Finder does not inherit a login shell's PATH; hc must still be discoverable.
/usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HOME/.local/bin:/opt/homebrew/bin:$PATH" "$app/Contents/Info.plist"
# ray/master: show the same number as `herdr-app --version` (release number plus the .rN revision, see src/fork.rs).
version=$("$exe" --version | awk '{print $2}')
/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $version" "$app/Contents/Info.plist"
codesign --force --sign - "$app"
# herdr-app stays the official app's link; this build gets its own command name.
ln -sfn "$exe" "$HOME/.local/bin/herdr-ray"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app. Quit and reopen Herdr to use the new build."
